{
  "name": "outlier-caucus",
  "version": "1.0.0",
  "description": "Scores stock trades disclosed by members of Congress for how unusual they are",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "outlier-caucus": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "ocr:catchup": "node --env-file-if-exists=.env dist/index.js ocr:catchup"
  },
  "keywords": [
    "congress",
    "trading",
    "stocks",
    "cli"
  ],
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "mupdf": "^1.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
